{
  "name": "inner-graph",
  "productName": "Inner Graph",
  "version": "0.3.7",
  "description": "A map of how your inner life fits together, built from what you write.",
  "author": "Inner Lattice",
  "homepage": "https://github.com/innerlattice/innergraph",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "build/main.mjs",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.99",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "diff": "^9.0.0",
    "hono": "^4.13.7",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.102",
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "concurrently": "^10.0.5",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "ts-api": "npm:typescript@^5.9.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "bin": {
    "inner-graph": "src/bin.ts"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/bin.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/bin.ts serve",
    "mcp": "tsx src/bin.ts mcp",
    "cli": "tsx src/bin.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "metrics": "tsx scripts/metrics.ts",
    "quality": "npm run typecheck && npm run lint && npm run unused && npm run styles && npm run coverage && npm run metrics",
    "fixture:reset": "tsx experiments/best-case/decompose.ts --fresh",
    "unused": "knip",
    "lint": "biome check .",
    "format": "biome check --write .",
    "styles": "tsx scripts/auditStyles.ts",
    "fingerprint": "tsx scripts/fingerprint.ts",
    "bundle": "tsx scripts/bundle.ts",
    "desktop": "npm run build && npm run bundle && electron .",
    "dist": "npm run build && npm run bundle && electron-builder --publish never",
    "ship": "tsx scripts/ship.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}
