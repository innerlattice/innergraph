{
  "name": "inner-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "diff": "^9.0.0",
    "hono": "^4.13.7",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "concurrently": "^10.0.5",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-api": "npm:typescript@^5.9.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "bin": {
    "inner-graph": "src/bin.ts"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/bin.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/bin.ts serve",
    "mcp": "tsx src/bin.ts mcp",
    "cli": "tsx src/bin.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "metrics": "tsx scripts/metrics.ts",
    "quality": "npm run typecheck && npm run coverage && npm run metrics"
  }
}
