{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.ts",
    "experiments/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "web/src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "experiments/**/*.ts",
    "test/**/*.ts",
    "web/src/**/*.css"
  ],
  "ignoreDependencies": [
    "@types/better-sqlite3"
  ],
  "ignoreExportsUsedInFile": false
}
